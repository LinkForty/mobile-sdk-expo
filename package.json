{
  "name": "@linkforty/mobile-sdk-expo",
  "version": "1.10.0",
  "description": "Expo SDK for LinkForty - open-source alternative to Branch.io, AppsFlyer OneLink, and Firebase Dynamic Links. Deferred deep linking, attribution, and smart routing.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "node scripts/gen-version.mjs && tsc",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "linkforty",
    "deep-linking",
    "deferred-deep-linking",
    "mobile-attribution",
    "expo",
    "react-native",
    "universal-links",
    "app-links",
    "app-attribution",
    "branch-alternative",
    "appsflyer-alternative",
    "adjust-alternative",
    "firebase-dynamic-links",
    "self-hosted",
    "open-source",
    "privacy-focused"
  ],
  "author": "LinkForty",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LinkForty/mobile-sdk-expo.git"
  },
  "bugs": {
    "url": "https://github.com/LinkForty/mobile-sdk-expo/issues"
  },
  "homepage": "https://github.com/LinkForty/mobile-sdk-expo#readme",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": ">=1.23.1 <3.0.0",
    "@react-navigation/native": ">=6.0.0",
    "expo": ">=51.0.0",
    "expo-application": ">=5.9.0",
    "expo-device": ">=6.0.0",
    "expo-linking": ">=6.3.0",
    "expo-localization": ">=15.0.0",
    "react": ">=18.0.0",
    "react-native": ">=0.74.0"
  },
  "peerDependenciesMeta": {
    "@react-navigation/native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^10.3.5",
    "@semantic-release/npm": "^13.1.5",
    "@types/react": "^19.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "conventional-changelog-conventionalcommits": "^7.0.2",
    "expo": "~58.0.20",
    "expo-application": "~58.1.2",
    "expo-device": "~58.0.5",
    "expo-linking": "~58.0.14",
    "expo-localization": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "semantic-release": "^25.0.3",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "files": [
    "dist/**/*",
    "src/**/*",
    "llms.txt",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
